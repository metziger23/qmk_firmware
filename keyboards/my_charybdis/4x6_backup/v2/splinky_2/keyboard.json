{
    "keyboard_name": "Charybdis (4x6) Splinky",
    "usb": {
        "device_version": "2.0.0"
    },
    "features": {
        "bootmagic": true,
        "mousekey": false,
        "extrakey": true,
        "rgb_matrix": true,
        "pointing_device": true
    },
    "rgb_matrix": {
        "driver": "ws2812"
    },
    "matrix_pins": {
        "cols": ["GP4", "GP5", "GP6", "GP7", "GP8", "GP9"],
        "rows": ["GP21", "GP29", "GP28", "GP27", "GP26"]
    },
    "diode_direction": "COL2ROW",
    "split": {
        "enabled": true,
        "soft_serial_pin": "GP1"
    },
    "ws2812": {
        "pin": "GP0",
        "driver": "vendor"
    },
    "processor": "RP2040",
    "bootloader": "rp2040"
}
