{
    "keyboard_name": "Charybdis (5x6) Splinky",
    "usb": {
        "device_version": "2.0.0"
    },
    "features": {
        "bootmagic": true,
        "mousekey": false,
        "extrakey": true,
        "rgb_matrix": false,
        "pointing_device": true
    },
    "rgb_matrix": {
        "driver": "ws2812"
    },
    "matrix_pins": {
        "cols": ["GP9", "GP8", "GP7", "GP5", "GP5", "GP4"],
        "rows": ["GP21", "GP29", "GP28", "GP27", "GP26", "GP10"]
    },
    "diode_direction": "COL2ROW",
    "split": {
        "enabled": true,
        "soft_serial_pin": "GP0"
    },
    "ws2812": {
        "pin": "GP17",
        "driver": "vendor"
    },
    "processor": "RP2040",
    "bootloader": "rp2040"
}
