{
    "keyboard_name": "Charybdis (5x6) Splinky",
    "usb": {
        "device_version": "2.0.0"
    },
    "features": {
        "bootmagic": true,
        "mousekey": false,
        "extrakey": true,
        "rgb_matrix": false,
        "pointing_device": true
    },
    "rgb_matrix": {
        "driver": "ws2812"
    },
    "matrix_pins": {
        "cols": ["GP15", "GP14", "GP13", "GP12", "GP11", "GP10"],
        "rows": ["GP4", "GP5", "GP6", "GP7", "GP8", "GP9"]
    },
    "diode_direction": "COL2ROW",
    "split": {
        "enabled": true,
        "soft_serial_pin": "GP29"
    },
    "ws2812": {
        "pin": "GP17",
        "driver": "vendor"
    },
    "processor": "RP2040",
    "bootloader": "rp2040"
}
